# Copy to .env and fill in. Never commit .env.

# Secret key (S...) of the staked keeper: it receives fees and signs
# authorizations. Leave empty and `npm run deploy` will generate and fund one.
STELLAR_SECRET_KEY=

# Optional channel accounts (comma-separated secret keys). They pay network
# fees and supply sequence numbers so several batches can be sent at once;
# the keeper above still signs each execution. Fund each with some XLM.
CHANNEL_SECRET_KEYS=

# Network: "testnet" (default), "mainnet" or "local" (stellar/quickstart on :8000)
STELLAR_NETWORK=testnet
# Required for mainnet; defaults to the public RPC for testnet and local.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Set automatically by `npm run deploy` (read from deployments/<network>.json otherwise)
SOROCRON_CONTRACT_ID=

# Keeper polling interval in milliseconds
POLL_INTERVAL_MS=10000

# Jobs per execute_batch transaction (1-20)
BATCH_SIZE=10

# Skip a batch if its fees minus the estimated network cost are below this,
# in stroops. Only checked when job fees are paid in the native token.
MIN_PROFIT_STROOPS=0

# Inclusion fee bid: this percentile of recent Soroban fees (p10 ... p99),
# raised step by step after failed sends, never above MAX_INCLUSION_FEE (stroops).
FEE_PERCENTILE=p70
MAX_INCLUSION_FEE=100000

# Reload every job from scratch every N ticks, as a safety net for the event index.
RESYNC_EVERY_TICKS=360

# Warn when the keeper's or a channel's XLM balance drops below this (whole XLM)
MIN_BALANCE_XLM=5

# Serve Prometheus metrics on :PORT/metrics and a liveness probe on
# :PORT/healthz. 0 or empty disables the server.
METRICS_PORT=9464

# "json" for one JSON object per log line; anything else is human-readable
LOG_FORMAT=text

# Post alerts (low balance, low stake, RPC down, failing sends) to a webhook.
# ALERT_FORMAT: discord, slack or generic (plain JSON). Each alert repeats at
# most once per ALERT_COOLDOWN_MS.
ALERT_WEBHOOK_URL=
ALERT_FORMAT=generic
ALERT_COOLDOWN_MS=3600000

# Copy to .env and fill in. Never commit .env.

# Secret key (S...) of the account that deploys and runs the keeper.
# Leave empty and `npm run deploy:testnet` will generate and fund one for you.
STELLAR_SECRET_KEY=

# Network: "testnet" (default) or "mainnet"
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Set automatically by deploy:testnet (read from deployments/testnet.json otherwise)
SOROCRON_CONTRACT_ID=

# Keeper polling interval in milliseconds
POLL_INTERVAL_MS=10000

# Warn when the keeper's native XLM balance drops below this (whole XLM)
MIN_BALANCE_XLM=5

# Skip a due job if fee_per_run - estimated network fee would be below this,
# in stroops. Only checked when the job's fee is paid in the native token.
MIN_PROFIT_STROOPS=0

# How many jobs' is_due checks to run in parallel per tick
MAX_CONCURRENCY=5

# Copy to .env and fill in. Never commit .env.

# Secret key (S...) of the account that deploys and runs the keeper.
# Leave empty and `npm run deploy:testnet` will generate and fund one for you.
STELLAR_SECRET_KEY=

# Network: "testnet" (default) or "mainnet"
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Set automatically by deploy:testnet (read from deployments/testnet.json otherwise)
SOROCRON_CONTRACT_ID=

# Keeper polling interval in milliseconds
POLL_INTERVAL_MS=10000

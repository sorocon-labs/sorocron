{
  "name": "@sorocron/sdk",
  "version": "0.3.0",
  "description": "Typed TypeScript client for the SoroCron automation registry on Stellar/Soroban",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorocon-labs/sorocron",
    "directory": "packages/sdk"
  },
  "keywords": ["stellar", "soroban", "automation", "cron", "keeper", "smart-contracts"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=17.1.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
